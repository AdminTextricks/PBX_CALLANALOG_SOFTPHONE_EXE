{
  "App": {
    "CompanyName": "CallAnalog",
    "Version": "1.2.0"
  },
  "Provisioning": {
    "UseCarrierFallback": true
  },
  "Sip": {
    "CarrierHost": "user.callanalog.com",
    "DefaultTransport": "tcp",
    "SipPort": 5065,
    "RegistrationExpirySeconds": 3600,
    "KeepAliveSeconds": 15,
    "TurnServer": "",
    "TurnPort": 3478,
    "TurnUsername": "",
    "TurnPassword": ""
  },
  "CrashReport": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "UseSsl": true,
    "FromEmail": "softphone@callanalog.com"
  },
  "PbxApi": {
    "BaseUrl": "https://pbxbackend.callanalog.com",
    "LoginPath": "/public/api/extension_login",
    "DesktopAppDomainPath": "/public/api/proxy-domain/get/desktopapp",
    "WebPhoneDomainPath": "/public/api/proxy-domain/get/webphone",
    "AndroidDomainPath": "/public/api/proxy-domain/get/android",
    "UnregisterPath": "/public/api/extensionUnregisterFromOpenSipsOtherApp/",
    "ContactsPath": "/public/api/phone-contact/getall",
    "ContactCreatePath": "/public/api/phone-contact",
    "ContactUpdatePath": "/public/api/phone-contact/update/",
    "ContactDeletePath": "/public/api/phone-contact/delete/",
    "CallHistoryPath": "/public/api/getCallHistory",
    "CallNotePath": "/public/api/callNote",
    "CallRatingPath": "/public/api/callRating",
    "PageSize": 25,
    "TimeoutSeconds": 30
  }
