<UserControl x:Class="CallAnalog.Softphone.Views.Panels.ContactFormPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CallAnalog.Softphone.Views.Controls"
             Width="252"
             Height="260"
             MinWidth="252"
             MaxWidth="252"
             MinHeight="260"
             MaxHeight="260"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

    <Border Background="{StaticResource PhoneSurfaceBrush}"
            BorderBrush="{StaticResource PhoneBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="12">

        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>

                <!-- Name -->
                <RowDefinition Height="Auto"/>

                <!-- Phone -->
                <RowDefinition Height="Auto"/>

                <!-- Validation area - always reserves space -->
                <RowDefinition Height="32"/>

                <!-- Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PhoneTextPrimaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <Button Grid.Column="1"
                        Width="22"
                        Height="22"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Close"
                        Click="CancelButton_Click">

                    <controls:PackIcon IconKey="IconSfXmarkCircleFill"
                                       IconSize="14"
                                       Foreground="{StaticResource PhoneTextSecondaryBrush}"/>
                </Button>
            </Grid>

            <!-- Name -->
            <StackPanel Grid.Row="1"
                        Margin="0,0,0,8">

                <TextBlock Text="Name"
                           FontSize="11"
                           Foreground="{StaticResource PhoneTextSecondaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBox x:Name="NameBox"
                         Style="{StaticResource PhoneTextBox}"
                         FontSize="12"
                         Padding="9,6"/>
            </StackPanel>

            <!-- Phone -->
            <StackPanel Grid.Row="2"
                        Margin="0,0,0,8">

                <TextBlock Text="Phone"
                           FontSize="11"
                           Foreground="{StaticResource PhoneTextSecondaryBrush}"
                           Margin="0,0,0,4"/>

                <TextBox x:Name="NumberBox"
                         Style="{StaticResource PhoneTextBox}"
                         FontSize="12"
                         Padding="9,6"
                         PreviewTextInput="NumberBox_PreviewTextInput"
                         DataObject.Pasting="NumberBox_Pasting"/>
            </StackPanel>

            <!-- Validation area
                 Fixed height so Add/Edit have identical layout geometry.
                 Hidden keeps the reserved space without displaying text. -->
            <Grid Grid.Row="3"
                  Height="32">

                <TextBlock x:Name="ErrorText"
                           FontSize="11"
                           Foreground="{StaticResource PhoneHangupRedBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           Visibility="Hidden"/>
            </Grid>

            <!-- Buttons -->
            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Style="{StaticResource PhoneSecondaryButton}"
                        FontSize="12"
                        Padding="10,6"
                        MinHeight="32"
                        Click="CancelButton_Click"/>

                <Button Grid.Column="2"
                        x:Name="SaveButton"
                        Content="Save"
                        Style="{StaticResource PhonePrimaryButton}"
                        FontSize="12"
                        Padding="10,6"
                        MinHeight="32"
                        Click="SaveButton_Click"/>
            </Grid>

        </Grid>
    </Border>
</UserControl>