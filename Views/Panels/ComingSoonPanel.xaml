<UserControl x:Class="CallAnalog.Softphone.Views.Panels.ComingSoonPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="268">
    <Border Style="{StaticResource ShellPanelBorder}">
        <StackPanel>
            <TextBlock Text="Coming soon"
                       Style="{StaticResource TypeTitle}"
                       Foreground="{StaticResource PhoneTextPrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="MessageText"
                       Style="{StaticResource TypeBody}"
                       Foreground="{StaticResource PhoneTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>
            <Button Content="OK"
                    Style="{StaticResource PhonePrimaryButton}"
                    Height="38"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Border>
</UserControl>
