<UserControl x:Class="CallAnalog.Softphone.Views.Panels.CallWrapUpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300">
    <Border Style="{StaticResource ShellPanelBorder}">
        <StackPanel>
            <TextBlock Text="Call ended"
                       Style="{StaticResource TypeTitle}"
                       Foreground="{StaticResource PhoneTextPrimaryBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="SummaryText"
                       Style="{StaticResource TypeBody}"
                       Foreground="{StaticResource PhoneTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Add a note" Style="{StaticResource SettingsLabel}"/>
            <TextBox x:Name="NoteBox"
                     Style="{StaticResource PhoneTextBox}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80"
                     Margin="0,0,0,12"/>

            <TextBlock Text="Rate your call"
                       Style="{StaticResource TypeCaption}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6"/>
            <StackPanel x:Name="RatingPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16"/>

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource TypeCaption}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SkipButton"
                        Grid.Column="0"
                        Content="Skip"
                        Style="{StaticResource PhoneSecondaryButton}"
                        Height="42"
                        Click="SkipButton_Click"/>
                <Button x:Name="SaveButton"
                        Grid.Column="2"
                        Content="Save"
                        Style="{StaticResource PhonePrimaryButton}"
                        Height="42"
                        Click="SaveButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
