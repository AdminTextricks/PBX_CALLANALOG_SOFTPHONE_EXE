<Window x:Class="CallAnalog.Softphone.Views.IncomingCallPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CallAnalog"
        Width="268"
        Height="180"
        MinWidth="268"
        MinHeight="180"
        MaxWidth="268"
        MaxHeight="180"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="ToolWindow"
        WindowStartupLocation="Manual"
        ShowActivated="True"
        Background="{StaticResource PhoneBgBrush}"
        Closing="Window_Closing">
    <Border Background="{StaticResource PhoneSurfaceBrush}"
            BorderBrush="{StaticResource PhoneCardBorderBrush}"
            BorderThickness="1"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText"
                           Text="Incoming Call"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PhoneTextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CallerNameText"
                           Text="Unknown"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PhoneTextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"/>
                <TextBlock x:Name="CallerNumberText"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource PhoneTextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DeclineButton"
                        Content="Decline"
                        Style="{StaticResource CallDeclineButton}"
                        Height="32"
                        MinWidth="0"
                        FontSize="11"
                        Click="DeclineButton_Click"/>
                <Button x:Name="AnswerButton"
                        Grid.Column="2"
                        Content="Answer"
                        Style="{StaticResource CallAnswerButton}"
                        Height="32"
                        MinWidth="0"
                        FontSize="11"
                        Click="AnswerButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
