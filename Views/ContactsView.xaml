<UserControl x:Class="CallAnalog.Softphone.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CallAnalog.Softphone.Views.Controls">
    <Grid Background="{StaticResource PhoneBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="16,8,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Contacts"
                       Style="{StaticResource TypeTitle}"
                       Foreground="{StaticResource PhoneTextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Style="{StaticResource HeaderIconButton}"
                    ToolTip="Refresh"
                    Margin="0,0,6,0"
                    Click="RefreshButton_Click">
                <TextBlock Text="&#x21BB;" FontSize="16" FontWeight="SemiBold"/>
            </Button>
            <Button Grid.Column="2"
                    Style="{StaticResource PhonePrimaryButton}"
                    Padding="12,6"
                    FontSize="12"
                    Click="AddContactButton_Click">
                <StackPanel Orientation="Horizontal">
                    <controls:PackIcon IconKey="IconAdd" IconSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Add" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:SearchField x:Name="SearchField"
                                  Grid.Column="0"
                                  Placeholder="Search contacts..."/>
            <Button Grid.Column="1"
                    Content="Search"
                    Style="{StaticResource PhonePrimaryButton}"
                    Margin="8,0,0,0"
                    Padding="14,8"
                    FontSize="12"
                    Click="SearchButton_Click"/>
        </Grid>

        <!-- Contact list -->
        <Grid Grid.Row="2" Margin="12,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource PhoneScrollViewer}">
                <ItemsControl x:Name="ContactsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PhoneSurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource PhoneCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="0,0,0,8"
                                    Padding="8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name + number — far left (tap to edit) -->
                                <Button Grid.Column="0"
                                        Style="{StaticResource ContactInfoButtonLeft}"
                                        Tag="{Binding}"
                                        Click="EditContactButton_Click"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <controls:AvatarCircle Width="40" Height="40"
                                                               DisplayName="{Binding Name}"
                                                               Number="{Binding Number}"
                                                               InitialsFontSize="13"
                                                               Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <controls:HighlightTextBlock Text="{Binding Name}"
                                                                         HighlightQuery="{Binding DataContext.SearchHighlightQuery, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         TextStyle="{StaticResource ListItemPrimaryText}"/>
                                            <controls:HighlightTextBlock Text="{Binding Number}"
                                                                         HighlightQuery="{Binding DataContext.SearchHighlightQuery, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         TextStyle="{StaticResource ListItemSecondaryText}"
                                                                         Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Action icons — far right -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <Button Style="{StaticResource ContactActionCallButton}"
                                            Tag="{Binding}"
                                            Click="DialContactButton_Click"
                                            ToolTip="Dial">
                                        <controls:PackIcon IconKey="IconPhone" Style="{StaticResource ActionPackIcon}"/>
                                    </Button>
                                    <Button Style="{StaticResource ContactActionMessageButton}"
                                            Tag="{Binding}"
                                            Click="CopyContactButton_Click"
                                            ToolTip="Copy number">
                                        <controls:PackIcon IconKey="IconCopy" Style="{StaticResource ActionPackIcon}"/>
                                    </Button>
                                    <Button Style="{StaticResource ContactActionDeleteButton}"
                                            Tag="{Binding}"
                                            Click="DeleteContactButton_Click"
                                            ToolTip="Delete">
                                        <controls:PackIcon IconKey="IconDelete" Style="{StaticResource ActionPackIcon}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Ellipse Style="{StaticResource LoadingSpinnerArc}">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="Loading contacts..."
                           Style="{StaticResource TypeCaption}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <controls:EmptyStateView x:Name="EmptyState"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Visibility="Collapsed"/>
        </Grid>

        <!-- Status / load more -->
        <StackPanel Grid.Row="3" Margin="16,4,16,8">
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="11"
                       Foreground="{StaticResource PhoneTextTertiaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>
            <Button x:Name="LoadMoreButton"
                    Style="{StaticResource PhoneSecondaryButton}"
                    Content="Load more"
                    Visibility="Collapsed"
                    Click="LoadMoreButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
