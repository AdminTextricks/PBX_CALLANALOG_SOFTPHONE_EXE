<UserControl x:Class="CallAnalog.Softphone.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CallAnalog.Softphone.Views.Controls">
    <UserControl.Resources>
        <Style x:Key="ContactsLoadMoreButton" TargetType="Button" BasedOn="{StaticResource PhoneSecondaryButton}">
            <Setter Property="Background" Value="{StaticResource PhoneSurfaceBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style x:Key="ContactsAccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PhoneTextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource PhoneAccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContactsRowActionButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource PhoneTextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContactsInfoButton" TargetType="Button" BasedOn="{StaticResource ContactInfoButtonLeft}">
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource PhoneBgBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Contacts"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PhoneTextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="22" Height="22"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Refresh"
                    Margin="0,0,6,0"
                    Click="RefreshButton_Click">
                <controls:PackIcon IconKey="IconSfArrowClockwise" IconSize="12"
                                   Foreground="{StaticResource PhoneTextPrimaryBrush}"/>
            </Button>
            <Button Grid.Column="2"
                    Style="{StaticResource ContactsAccentButton}"
                    Click="AddContactButton_Click">
                <StackPanel Orientation="Horizontal">
                    <controls:PackIcon IconKey="IconSfPlus" IconSize="12" Margin="0,0,4,0"
                                       Foreground="{StaticResource PhoneTextPrimaryBrush}"/>
                    <TextBlock Text="Add" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{StaticResource PhoneSurfaceElevatedBrush}"
                    BorderBrush="{StaticResource PhoneBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8,5"
                    Margin="0,0,8,0">
                <controls:SearchField x:Name="SearchField"
                                      Placeholder="Search contacts..."/>
            </Border>
            <Button Grid.Column="1"
                    Content="Search"
                    Style="{StaticResource ContactsAccentButton}"
                    Click="SearchButton_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ThinListScrollViewer}">
                <ItemsControl x:Name="ContactsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PhoneSurfaceElevatedBrush}"
                                    BorderBrush="{StaticResource PhoneCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="0,0,0,4"
                                    Padding="8,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource ContactsInfoButton}"
                                            Tag="{Binding}"
                                            Click="EditContactButton_Click"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <controls:AvatarCircle Width="32" Height="32"
                                                                   DisplayName="{Binding Name}"
                                                                   Number="{Binding Number}"
                                                                   InitialsFontSize="11"
                                                                   Margin="0,0,8,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <controls:HighlightTextBlock Text="{Binding Name}"
                                                                             HighlightQuery="{Binding DataContext.SearchHighlightQuery, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             TextStyle="{StaticResource ListItemPrimaryText}"/>
                                                <controls:HighlightTextBlock Text="{Binding Number}"
                                                                             HighlightQuery="{Binding DataContext.SearchHighlightQuery, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                             TextStyle="{StaticResource ListItemSecondaryText}"
                                                                             Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Style="{StaticResource ContactsRowActionButton}"
                                                Background="{StaticResource PhoneCallGreenBrush}"
                                                Tag="{Binding}"
                                                Click="DialContactButton_Click"
                                                ToolTip="Call">
                                            <controls:PackIcon IconKey="IconSfPhoneFill" IconSize="11"
                                                               Foreground="{StaticResource PhoneTextPrimaryBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource ContactsRowActionButton}"
                                                Background="{StaticResource PhoneAccentBrush}"
                                                Tag="{Binding}"
                                                Click="CopyContactButton_Click"
                                                ToolTip="Copy number">
                                            <controls:PackIcon IconKey="IconSfDocOnDoc" IconSize="11"
                                                               Foreground="{StaticResource PhoneTextPrimaryBrush}"/>
                                        </Button>
                                        <Button Style="{StaticResource ContactsRowActionButton}"
                                                Background="{StaticResource PhoneHangupRedBrush}"
                                                Margin="0"
                                                Tag="{Binding}"
                                                Click="DeleteContactButton_Click"
                                                ToolTip="Delete">
                                            <controls:PackIcon IconKey="IconSfTrash" IconSize="11"
                                                               Foreground="{StaticResource PhoneTextPrimaryBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Ellipse Style="{StaticResource LoadingSpinnerArc}">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="Loading contacts..."
                           FontSize="11"
                           Foreground="{StaticResource PhoneTextSecondaryBrush}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <controls:EmptyStateView x:Name="EmptyState"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="11"
                       Foreground="{StaticResource PhoneTextSecondaryBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <Button x:Name="LoadMoreButton"
                    Style="{StaticResource ContactsLoadMoreButton}"
                    Content="Load more"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed"
                    Click="LoadMoreButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
