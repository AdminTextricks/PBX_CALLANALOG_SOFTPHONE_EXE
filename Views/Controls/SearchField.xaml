<UserControl x:Class="CallAnalog.Softphone.Views.Controls.SearchField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CallAnalog.Softphone.Views.Controls"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <controls:PackIcon IconKey="IconSfMagnifyingGlass"
                           IconSize="11"
                           Foreground="{StaticResource PhoneTextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"
                           IsHitTestVisible="False"/>
        <TextBox x:Name="InputBox"
                 Grid.Column="1"
                 BorderThickness="0"
                 Background="Transparent"
                 FontSize="12"
                 Foreground="{StaticResource PhoneTextPrimaryBrush}"
                 CaretBrush="{StaticResource PhoneTextPrimaryBrush}"
                 Padding="0"
                 VerticalAlignment="Center"
                 Cursor="IBeam"
                 Text="{Binding Query, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InputBox_KeyDown"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding Placeholder, ElementName=Root}"
                   Foreground="{StaticResource PhoneTextTertiaryBrush}"
                   FontSize="12"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Query, ElementName=Root}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
