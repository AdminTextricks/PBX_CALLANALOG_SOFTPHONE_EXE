<UserControl x:Class="CallAnalog.Softphone.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CallAnalog.Softphone.Views.Controls">
    <Grid Margin="12,4,12,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="WelcomeText"
                   Grid.Row="0"
                   Text="Good morning"
                   Style="{StaticResource TypeTitle}"
                   Foreground="{StaticResource PhoneTextPrimaryBrush}"
                   Margin="0,0,0,4"/>

        <!-- Dialpad hero -->
        <Border Grid.Row="1" Style="{StaticResource GlassCardBorder}" Margin="0,0,0,7" Padding="0">
            <Button Style="{StaticResource DashboardDialpadHeroButton}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="DialpadButton_Click">
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="34" Height="34"
                            CornerRadius="17"
                            Background="{StaticResource PhoneHeroOverlayBrush}"
                            Margin="0,0,10,0">
                        <controls:PackIcon IconKey="IconDialpad"
                                           IconSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Open Dialpad"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Place a call"
                                   FontSize="10"
                                   Opacity="0.85"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </Border>

        <!-- DND / Auto Answer -->
        <Grid Grid.Row="2" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DndButton"
                    Grid.Column="0"
                    Style="{StaticResource DashboardDndPill}"
                    Click="DndButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DND" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            x:Name="DndStatusChip"
                            Background="{StaticResource PhoneChipBgBrush}"
                            CornerRadius="10"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="DndStatusText"
                                   Text="OFF"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PhoneTextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Button>
            <Button x:Name="AutoAnswerButton"
                    Grid.Column="2"
                    Style="{StaticResource DashboardAutoAnswerPill}"
                    Click="AutoAnswerButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Answer" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            x:Name="AutoAnswerStatusChip"
                            Background="{StaticResource PhoneChipBgBrush}"
                            CornerRadius="10"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="AutoAnswerStatusText"
                                   Text="OFF"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PhoneTextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <!-- SMS / Voicemail -->
        <Grid Grid.Row="3" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource GlassCardBorder}" Padding="0">
                <Button Style="{StaticResource DashboardTileButton}" Background="Transparent" Click="SmsButton_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <controls:PackIcon IconKey="IconSms" IconSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="SMS" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource GlassCardBorder}" Padding="0">
                <Button Style="{StaticResource DashboardTileButton}" Background="Transparent" Click="VoicemailButton_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <controls:PackIcon IconKey="IconVoicemail" IconSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Voicemail" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="Today"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PhoneAccentBrush}"
                   Margin="0,0,0,4"/>

        <Grid Grid.Row="5" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource StatCardButton}" Click="MadeButton_Click">
                <StackPanel>
                    <TextBlock x:Name="MadeCountText" Text="0" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Made" FontSize="10" Foreground="{StaticResource PhoneTextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource StatCardButton}" Margin="4,0" Click="AnsweredButton_Click">
                <StackPanel>
                    <TextBlock x:Name="AnsweredCountText" Text="0" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Received" FontSize="10" Foreground="{StaticResource PhoneTextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource StatCardButton}" Click="MissedButton_Click">
                <StackPanel>
                    <TextBlock x:Name="MissedCountText" Text="0" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Missed" FontSize="10" Foreground="{StaticResource PhoneTextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="6"
                   Text="Recent Calls"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PhoneTextPrimaryBrush}"
                   Margin="0,0,0,4"/>

        <Border x:Name="RecentCallsHost"
                Grid.Row="7"
                ClipToBounds="True"
                SizeChanged="RecentCallsHost_SizeChanged">
            <Grid>
                <ItemsControl x:Name="RecentCallsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RecentCallRowButton}"
                                    Tag="{Binding}"
                                    Click="RecentCallButton_Click"
                                    Padding="0,2">
                                <Border Style="{StaticResource RecentCallCardBorder}" Padding="8,6" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="2" Margin="0,4,8,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource PhoneAccentBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistoryTone}" Value="Answered">
                                                            <Setter Property="Background" Value="{StaticResource HistoryAnsweredBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HistoryTone}" Value="Missed">
                                                            <Setter Property="Background" Value="{StaticResource HistoryMissedBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HistoryTone}" Value="Cancel">
                                                            <Setter Property="Background" Value="{StaticResource HistoryCancelBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HistoryTone}" Value="Outbound">
                                                            <Setter Property="Background" Value="{StaticResource HistoryOutboundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <controls:AvatarCircle Grid.Column="1"
                                                               Width="36" Height="36"
                                                               DisplayName="{Binding DisplayName}"
                                                               Number="{Binding DialNumber}"
                                                               InitialsFontSize="12"
                                                               Margin="0,0,8,0"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ListItemPrimaryText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DialNumber}" Style="{StaticResource ListItemSecondaryText}"
                                                       FontFamily="Consolas, Courier New, monospace"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding CallDate}" Style="{StaticResource ListItemMetaText}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="72"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <controls:SkeletonShimmer x:Name="RecentCallsSkeleton"
                                          RowCount="3"
                                          Visibility="Collapsed"/>

                <controls:EmptyStateView x:Name="RecentCallsEmptyState"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- DND overlay -->
        <Border x:Name="DndOverlay"
                Grid.RowSpan="8"
                Background="#990D1117"
                Visibility="Collapsed"
                Panel.ZIndex="5">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:PackIcon IconKey="IconCancel" IconSize="32" Foreground="{StaticResource PhoneHangupRedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Do Not Disturb"
                           Style="{StaticResource TypeTitle}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4"/>
                <TextBlock Text="Incoming calls are silenced on this device."
                           Style="{StaticResource TypeCaption}"
                           TextAlignment="Center"
                           MaxWidth="260"
                           Margin="0,0,0,16"/>
                <Button Content="Turn Off DND"
                        Style="{StaticResource PhonePrimaryButton}"
                        Padding="16,8"
                        Click="TurnOffDndButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
