<UserControl x:Class="CallAnalog.Softphone.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CallAnalog.Softphone.Views.Controls">
    <Grid Margin="7,5,7,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MaxHeight="205"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="WelcomeText"
                   Grid.Row="0"
                   Text="Good morning"
                   FontSize="12"
                   FontWeight="Medium"
                   Foreground="{StaticResource PhoneTextPrimaryBrush}"
                   Margin="0,0,0,2"/>

        <!-- Dialpad hero — macOS green card, radius 16 -->
        <Button Grid.Row="1"
                Style="{StaticResource DashboardDialpadHeroButton}"
                Margin="0,0,0,7"
                Click="DialpadButton_Click">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="28" Height="28"
                        CornerRadius="14"
                        Background="{StaticResource PhoneHeroOverlayBrush}"
                        Margin="0,0,8,0">
                    <controls:PackIcon IconKey="IconSfGrid3x3Fill"
                                       IconSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Open Dialpad"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Place a call"
                               FontSize="10"
                               Opacity="0.85"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </Button>

        <!-- DND / Auto Answer -->
        <Grid Grid.Row="2" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DndButton"
                    Grid.Column="0"
                    Style="{StaticResource DashboardDndPill}"
                    Click="DndButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DND" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            x:Name="DndStatusChip"
                            Background="{StaticResource PhoneChipBgBrush}"
                            CornerRadius="10"
                            Padding="5,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="DndStatusText"
                                   Text="OFF"
                                   FontSize="7"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PhoneTextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Button>
            <Button x:Name="AutoAnswerButton"
                    Grid.Column="2"
                    Style="{StaticResource DashboardAutoAnswerPill}"
                    Click="AutoAnswerButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Auto Answer" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Column="1"
                            x:Name="AutoAnswerStatusChip"
                            Background="{StaticResource PhoneChipBgBrush}"
                            CornerRadius="10"
                            Padding="5,2"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="AutoAnswerStatusText"
                                   Text="OFF"
                                   FontSize="7"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PhoneTextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Button>
        </Grid>

        <!-- SMS / Voicemail -->
        <Grid Grid.Row="3" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource DashboardTileButton}"
                    Click="SmsButton_Click">
                <StackPanel HorizontalAlignment="Center">
                    <controls:PackIcon IconKey="IconSms" IconSize="13" HorizontalAlignment="Center"/>
                    <TextBlock Text="SMS" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Style="{StaticResource DashboardTileButton}"
                    Click="VoicemailButton_Click">
                <StackPanel HorizontalAlignment="Center">
                    <controls:PackIcon IconKey="IconVoicemail" IconSize="13" HorizontalAlignment="Center"/>
                    <TextBlock Text="Voicemail" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="Today"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PhoneAccentBrush}"
                   Margin="0,0,0,3"/>

        <Grid Grid.Row="5" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource StatCardButton}" Click="MadeButton_Click">
                <StackPanel>
                    <TextBlock x:Name="MadeCountText" Text="0" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Made" FontSize="9" Foreground="{StaticResource PhoneTextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource StatCardButton}" Click="AnsweredButton_Click">
                <StackPanel>
                    <TextBlock x:Name="AnsweredCountText" Text="0" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Received" FontSize="9" Foreground="{StaticResource PhoneTextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Style="{StaticResource StatCardButton}" Click="MissedButton_Click">
                <StackPanel>
                    <TextBlock x:Name="MissedCountText" Text="0" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Missed" FontSize="9" Foreground="{StaticResource PhoneTextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="6"
                   Text="Recent Calls"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PhoneTextPrimaryBrush}"
                   Margin="0,0,0,3"/>

        <Border x:Name="RecentCallsHost"
                Grid.Row="7"
                ClipToBounds="True">
            <Grid>
                <ScrollViewer x:Name="RecentCallsScroll"
                              Style="{StaticResource PhoneScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <ItemsControl x:Name="RecentCallsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RecentCallRowButton}"
                                        Tag="{Binding}"
                                        Click="RecentCallButton_Click"
                                        Padding="0"
                                        Margin="0,0,0,3">
                                    <Border Style="{StaticResource RecentCallCardBorder}" Padding="7,5" Margin="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*" MinWidth="0"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="28"
                                                    Height="28"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <controls:PackIcon IconKey="{Binding DirectionIconKey}"
                                                                   IconSize="16"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                    <controls:PackIcon.Style>
                                                        <Style TargetType="controls:PackIcon">
                                                            <Setter Property="Foreground" Value="{StaticResource PhoneAccentBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutbound}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource PhoneTextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMissed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource PhoneHangupRedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:PackIcon.Style>
                                                </controls:PackIcon>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0">
                                                <TextBlock Text="{Binding RecentPrimaryName}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource PhoneTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding RecentNumberLine}"
                                                           FontSize="10"
                                                           FontFamily="Consolas, Courier New, monospace"
                                                           Foreground="{StaticResource PhoneTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding RecentDurationLabel}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           FontFamily="Consolas, Courier New, monospace"
                                                           Foreground="{StaticResource PhoneTextPrimaryBrush}"
                                                           TextAlignment="Right"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding RecentTimestampLabel}"
                                                           FontSize="8"
                                                           Foreground="{StaticResource PhoneTextTertiaryBrush}"
                                                           TextAlignment="Right"
                                                           TextWrapping="NoWrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <controls:SkeletonShimmer x:Name="RecentCallsSkeleton"
                                          RowCount="3"
                                          Visibility="Collapsed"/>

                <StackPanel x:Name="RecentCallsEmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="No recent calls"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PhoneTextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Your latest calls will appear here."
                               FontSize="9"
                               Foreground="{StaticResource PhoneTextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DND overlay -->
        <Border x:Name="DndOverlay"
                Grid.RowSpan="8"
                Background="#990D1117"
                Visibility="Collapsed"
                Panel.ZIndex="5">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <controls:PackIcon IconKey="IconSfXmarkCircleFill" IconSize="30" Foreground="{StaticResource PhoneHangupRedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Do Not Disturb"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PhoneTextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4"/>
                <TextBlock Text="Incoming calls are silenced on this device."
                           FontSize="13"
                           Foreground="{StaticResource PhoneTextSecondaryBrush}"
                           TextAlignment="Center"
                           MaxWidth="240"
                           Margin="0,0,0,12"/>
                <Button Content="Turn Off DND"
                        Style="{StaticResource PhonePrimaryButton}"
                        FontSize="15"
                        Padding="16,10"
                        Click="TurnOffDndButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
