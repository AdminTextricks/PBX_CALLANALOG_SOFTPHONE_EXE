<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CallAnalog.Softphone</RootNamespace>
    <AssemblyName>CallAnalog.Softphone</AssemblyName>
    <ApplicationTitle>CallAnalog Softphone</ApplicationTitle>
    <Product>CallAnalog Softphone</Product>
    <Company>CallAnalog</Company>
    <Version>2.3.0</Version>
    <ApplicationIcon>CallAnalog.Softphone.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);CallAnalog.Softphone.Tests/**;*_wpftmp.csproj;**/*_wpftmp.csproj</DefaultItemExcludes>
    <!-- WPF markup compile writes random *_wpftmp.csproj next to this project. Hot reload / watch
         treating those as extra projects races MarkupCompilePass2 and produces BG1002 missing .baml. -->
    <HotReloadEnabled>false</HotReloadEnabled>
    <WatchdogProject>$(MSBuildThisFileDirectory)tools\CallAnalog.Watchdog\CallAnalog.Watchdog.csproj</WatchdogProject>
    <WatchdogPublishDir>$(MSBuildThisFileDirectory)tools\CallAnalog.Watchdog\bin\$(Configuration)\publish-win-x64\</WatchdogPublishDir>
    <WatchdogExeName>CallAnalog.Watchdog.exe</WatchdogExeName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CallAnalog.Softphone.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="SIPSorcery" Version="8.0.23" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tools/**" />
    <Compile Remove="CallAnalog.Softphone.Tests/**" />
    <None Remove="tools/**" />
    <None Remove="CallAnalog.Softphone.Tests/**" />
    <Content Remove="tools/**" />
    <EmbeddedResource Remove="tools/**" />
    <Page Remove="tools/**" />
    <Watch Remove="obj\**\*" />
    <Watch Remove="bin\**\*" />
    <Watch Remove="*_wpftmp.csproj" />
    <Watch Remove="**\*_wpftmp.csproj" />
    <Watch Remove="**\*_wpftmp.csproj.user" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Assets\logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="Assets\favicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="build-info.txt" Condition="Exists('build-info.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="PublishCallAnalogWatchdog" Condition="'$(MSBuildProjectName)' == 'CallAnalog.Softphone'">
    <MSBuild
      Projects="$(WatchdogProject)"
      Targets="Restore"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;Version=$(Version);FileVersion=$(Version).0;InformationalVersion=$(InformationalVersion)" />
    <MSBuild
      Projects="$(WatchdogProject)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishDir=$(WatchdogPublishDir);Version=$(Version);FileVersion=$(Version).0;InformationalVersion=$(InformationalVersion)" />
  </Target>

  <Target Name="CopyCallAnalogWatchdogToOutput" AfterTargets="AfterBuild" DependsOnTargets="PublishCallAnalogWatchdog" Condition="'$(MSBuildProjectName)' == 'CallAnalog.Softphone'">
    <Copy
      SourceFiles="$(WatchdogPublishDir)$(WatchdogExeName)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCallAnalogWatchdogToPublish" AfterTargets="Publish" DependsOnTargets="PublishCallAnalogWatchdog" Condition="'$(MSBuildProjectName)' == 'CallAnalog.Softphone'">
    <Copy
      SourceFiles="$(WatchdogPublishDir)$(WatchdogExeName)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DeleteWpfTemporaryProjectFiles" AfterTargets="CleanupTemporaryTargetAssembly">
    <ItemGroup>
      <_WpfTmpProjects Include="$(MSBuildProjectDirectory)\$(MSBuildProjectName)_*_wpftmp.csproj" />
    </ItemGroup>
    <Delete Files="@(_WpfTmpProjects)" ContinueOnError="true" TreatErrorsAsWarnings="true" />
  </Target>

</Project>
