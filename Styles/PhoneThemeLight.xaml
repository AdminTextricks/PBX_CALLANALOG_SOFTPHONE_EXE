<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Premium light palette — cool slate + teal accent (CallAnalog) -->
    <Color x:Key="PhoneBg">#F4F7FB</Color>
    <Color x:Key="PhoneSurface">#FFFFFF</Color>
    <Color x:Key="PhoneSurfaceElevated">#FFFFFF</Color>
    <Color x:Key="PhoneSurfaceHover">#E8EEF6</Color>
    <Color x:Key="PhoneBorder">#C9D4E3</Color>
    <Color x:Key="PhoneTextPrimary">#0F172A</Color>
    <Color x:Key="PhoneTextSecondary">#475569</Color>
    <Color x:Key="PhoneTextTertiary">#64748B</Color>
    <Color x:Key="PhoneAccent">#0284C7</Color>
    <Color x:Key="PhoneBrand">#0E7490</Color>
    <Color x:Key="PhoneBezel">#E2E8F0</Color>
    <Color x:Key="PhoneBezelOuter">#E8EEF5</Color>
    <Color x:Key="PhoneCardBorder">#D7E0EC</Color>
    <Color x:Key="PhoneDivider">#E2E8F0</Color>
    <Color x:Key="PhoneChipBg">#EEF3F9</Color>
    <Color x:Key="PhoneNavActiveBg">#DDF0F5</Color>
    <Color x:Key="PhoneStatusOnlineBg">#DCFCE7</Color>
    <Color x:Key="PhoneStatusRegisteringBg">#FEF3C7</Color>
    <Color x:Key="PhoneStatusDisconnectedBg">#FEE2E2</Color>
    <Color x:Key="PhoneHeroOverlay">#140F172A</Color>
    <Color x:Key="PhoneDndActiveBg">#FEE2E2</Color>
    <Color x:Key="PhoneDndActiveText">#B91C1C</Color>
    <Color x:Key="PhoneAutoAnswerActiveBg">#DCFCE7</Color>
    <Color x:Key="PhoneAutoAnswerActiveText">#166534</Color>
    <Color x:Key="PhoneToggleActiveBg">#DDF0F5</Color>
    <Color x:Key="HistoryMissedTint">#FEE2E2</Color>
    <Color x:Key="HistoryAnsweredTint">#DCFCE7</Color>
    <Color x:Key="HistoryCancelTint">#E0F2FE</Color>
    <Color x:Key="HistoryOutboundTint">#E0F2FE</Color>
    <Color x:Key="HistoryInboundTint">#DCFCE7</Color>

    <SolidColorBrush x:Key="PhoneBgBrush" Color="{StaticResource PhoneBg}" />
    <SolidColorBrush x:Key="PhoneSurfaceBrush" Color="{StaticResource PhoneSurface}" />
    <SolidColorBrush x:Key="PhoneSurfaceElevatedBrush" Color="{StaticResource PhoneSurfaceElevated}" />
    <SolidColorBrush x:Key="PhoneSurfaceHoverBrush" Color="{StaticResource PhoneSurfaceHover}" />
    <SolidColorBrush x:Key="PhoneBorderBrush" Color="{StaticResource PhoneBorder}" />
    <SolidColorBrush x:Key="PhoneTextPrimaryBrush" Color="{StaticResource PhoneTextPrimary}" />
    <SolidColorBrush x:Key="PhoneTextSecondaryBrush" Color="{StaticResource PhoneTextSecondary}" />
    <SolidColorBrush x:Key="PhoneTextTertiaryBrush" Color="{StaticResource PhoneTextTertiary}" />
    <SolidColorBrush x:Key="PhoneAccentBrush" Color="{StaticResource PhoneAccent}" />
    <SolidColorBrush x:Key="PhoneBrandBrush" Color="{StaticResource PhoneBrand}" />
    <SolidColorBrush x:Key="PhoneBezelBrush" Color="{StaticResource PhoneBezel}" />
    <SolidColorBrush x:Key="PhoneBezelOuterBrush" Color="{StaticResource PhoneBezelOuter}" />
    <SolidColorBrush x:Key="PhoneCardBorderBrush" Color="{StaticResource PhoneCardBorder}" />
    <SolidColorBrush x:Key="PhoneDividerBrush" Color="{StaticResource PhoneDivider}" />
    <SolidColorBrush x:Key="PhoneChipBgBrush" Color="{StaticResource PhoneChipBg}" />
    <SolidColorBrush x:Key="PhoneNavActiveBgBrush" Color="{StaticResource PhoneNavActiveBg}" />
    <SolidColorBrush x:Key="PhoneStatusOnlineBgBrush" Color="{StaticResource PhoneStatusOnlineBg}" />
    <SolidColorBrush x:Key="PhoneStatusRegisteringBgBrush" Color="{StaticResource PhoneStatusRegisteringBg}" />
    <SolidColorBrush x:Key="PhoneStatusDisconnectedBgBrush" Color="{StaticResource PhoneStatusDisconnectedBg}" />
    <SolidColorBrush x:Key="PhoneHeroOverlayBrush" Color="{StaticResource PhoneHeroOverlay}" />
    <SolidColorBrush x:Key="PhoneDndActiveBgBrush" Color="{StaticResource PhoneDndActiveBg}" />
    <SolidColorBrush x:Key="PhoneDndActiveTextBrush" Color="{StaticResource PhoneDndActiveText}" />
    <SolidColorBrush x:Key="PhoneAutoAnswerActiveBgBrush" Color="{StaticResource PhoneAutoAnswerActiveBg}" />
    <SolidColorBrush x:Key="PhoneAutoAnswerActiveTextBrush" Color="{StaticResource PhoneAutoAnswerActiveText}" />
    <SolidColorBrush x:Key="PhoneToggleActiveBgBrush" Color="{StaticResource PhoneToggleActiveBg}" />
    <SolidColorBrush x:Key="HistoryMissedBgBrush" Color="{StaticResource HistoryMissedTint}" />
    <SolidColorBrush x:Key="HistoryAnsweredBgBrush" Color="{StaticResource HistoryAnsweredTint}" />
    <SolidColorBrush x:Key="HistoryCancelBgBrush" Color="{StaticResource HistoryCancelTint}" />
    <SolidColorBrush x:Key="HistoryOutboundBgBrush" Color="{StaticResource HistoryOutboundTint}" />
    <SolidColorBrush x:Key="HistoryInboundBgBrush" Color="{StaticResource HistoryInboundTint}" />

</ResourceDictionary>
