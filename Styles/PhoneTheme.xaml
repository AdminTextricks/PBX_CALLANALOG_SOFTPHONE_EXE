<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CallAnalog.Softphone.Views.Controls">

    <Color x:Key="PhoneBg">#0D1117</Color>
    <Color x:Key="PhoneSurface">#1C2526</Color>
    <Color x:Key="PhoneSurfaceElevated">#1F2937</Color>
    <Color x:Key="PhoneSurfaceHover">#374151</Color>
    <Color x:Key="PhoneBorder">#475569</Color>
    <Color x:Key="PhoneTextPrimary">#FFFFFF</Color>
    <Color x:Key="PhoneTextSecondary">#9CA3AF</Color>
    <Color x:Key="PhoneTextTertiary">#64748B</Color>
    <Color x:Key="PhoneAccent">#0EA5E9</Color>
    <Color x:Key="PhoneBrand">#0E7490</Color>
    <Color x:Key="PhoneCallGreen">#10B981</Color>
    <Color x:Key="PhoneHangupRed">#DC2626</Color>
    <Color x:Key="PhoneBezel">#1A1A1A</Color>
    <Color x:Key="PhoneBezelOuter">#0D1117</Color>
    <Color x:Key="PhoneCardBorder">#2D3748</Color>
    <Color x:Key="PhoneDivider">#334155</Color>
    <Color x:Key="PhoneChipBg">#1F2937</Color>
    <Color x:Key="PhoneNavActiveBg">#1A3A5C</Color>
    <Color x:Key="PhoneStatusOnlineBg">#1A3A2A</Color>
    <Color x:Key="PhoneStatusRegistering">#F59E0B</Color>
    <Color x:Key="PhoneStatusRegisteringBg">#3A2A10</Color>
    <Color x:Key="PhoneStatusReconnecting">#F97316</Color>
    <Color x:Key="PhoneStatusDisconnected">#DC2626</Color>
    <Color x:Key="PhoneStatusDisconnectedBg">#3A1A1A</Color>
    <Color x:Key="PhoneStatusLoggedOut">#475569</Color>
    <Color x:Key="PhoneHeroOverlay">#33FFFFFF</Color>
    <Color x:Key="PhoneDndActiveBg">#3A1A1A</Color>
    <Color x:Key="PhoneDndActiveText">#FCA5A5</Color>
    <Color x:Key="PhoneAutoAnswerActiveBg">#1A3A2A</Color>
    <Color x:Key="PhoneAutoAnswerActiveText">#86EFAC</Color>
    <Color x:Key="PhoneToggleActiveBg">#1A3A5C</Color>
    <Color x:Key="HistoryMissedTint">#3A1A1A</Color>
    <Color x:Key="HistoryAnsweredTint">#1A3A2A</Color>
    <Color x:Key="HistoryCancelTint">#1A2A3A</Color>
    <Color x:Key="HistoryOutboundTint">#1A2A3A</Color>
    <Color x:Key="HistoryInboundTint">#1A3A2A</Color>

    <SolidColorBrush x:Key="PhoneBgBrush" Color="{StaticResource PhoneBg}" />
    <SolidColorBrush x:Key="PhoneSurfaceBrush" Color="{StaticResource PhoneSurface}" />
    <SolidColorBrush x:Key="PhoneSurfaceElevatedBrush" Color="{StaticResource PhoneSurfaceElevated}" />
    <SolidColorBrush x:Key="PhoneSurfaceHoverBrush" Color="{StaticResource PhoneSurfaceHover}" />
    <SolidColorBrush x:Key="PhoneBorderBrush" Color="{StaticResource PhoneBorder}" />
    <SolidColorBrush x:Key="PhoneTextPrimaryBrush" Color="{StaticResource PhoneTextPrimary}" />
    <SolidColorBrush x:Key="PhoneTextSecondaryBrush" Color="{StaticResource PhoneTextSecondary}" />
    <SolidColorBrush x:Key="PhoneTextTertiaryBrush" Color="{StaticResource PhoneTextTertiary}" />
    <SolidColorBrush x:Key="PhoneAccentBrush" Color="{StaticResource PhoneAccent}" />
    <SolidColorBrush x:Key="PhoneBrandBrush" Color="{StaticResource PhoneBrand}" />
    <SolidColorBrush x:Key="PhoneCallGreenBrush" Color="{StaticResource PhoneCallGreen}" />
    <SolidColorBrush x:Key="PhoneHangupRedBrush" Color="{StaticResource PhoneHangupRed}" />
    <SolidColorBrush x:Key="PhoneBezelBrush" Color="{StaticResource PhoneBezel}" />
    <SolidColorBrush x:Key="PhoneBezelOuterBrush" Color="{StaticResource PhoneBezelOuter}" />
    <SolidColorBrush x:Key="PhoneCardBorderBrush" Color="{StaticResource PhoneCardBorder}" />
    <SolidColorBrush x:Key="PhoneDividerBrush" Color="{StaticResource PhoneDivider}" />
    <SolidColorBrush x:Key="PhoneChipBgBrush" Color="{StaticResource PhoneChipBg}" />
    <SolidColorBrush x:Key="PhoneNavActiveBgBrush" Color="{StaticResource PhoneNavActiveBg}" />
    <SolidColorBrush x:Key="PhoneStatusOnlineBgBrush" Color="{StaticResource PhoneStatusOnlineBg}" />
    <SolidColorBrush x:Key="PhoneStatusOnlineBrush" Color="{StaticResource PhoneCallGreen}" />
    <SolidColorBrush x:Key="PhoneStatusOfflineBrush" Color="{StaticResource PhoneTextTertiary}" />
    <SolidColorBrush x:Key="PhoneStatusRegisteringBrush" Color="{StaticResource PhoneStatusRegistering}" />
    <SolidColorBrush x:Key="PhoneStatusRegisteringBgBrush" Color="{StaticResource PhoneStatusRegisteringBg}" />
    <SolidColorBrush x:Key="PhoneStatusReconnectingBrush" Color="{StaticResource PhoneStatusReconnecting}" />
    <SolidColorBrush x:Key="PhoneStatusDisconnectedBrush" Color="{StaticResource PhoneStatusDisconnected}" />
    <SolidColorBrush x:Key="PhoneStatusDisconnectedBgBrush" Color="{StaticResource PhoneStatusDisconnectedBg}" />
    <SolidColorBrush x:Key="PhoneStatusLoggedOutBrush" Color="{StaticResource PhoneStatusLoggedOut}" />
    <SolidColorBrush x:Key="PhoneHeroOverlayBrush" Color="{StaticResource PhoneHeroOverlay}" />
    <SolidColorBrush x:Key="PhoneDndActiveBgBrush" Color="{StaticResource PhoneDndActiveBg}" />
    <SolidColorBrush x:Key="PhoneDndActiveTextBrush" Color="{StaticResource PhoneDndActiveText}" />
    <SolidColorBrush x:Key="PhoneAutoAnswerActiveBgBrush" Color="{StaticResource PhoneAutoAnswerActiveBg}" />
    <SolidColorBrush x:Key="PhoneAutoAnswerActiveTextBrush" Color="{StaticResource PhoneAutoAnswerActiveText}" />
    <SolidColorBrush x:Key="PhoneToggleActiveBgBrush" Color="{StaticResource PhoneToggleActiveBg}" />
    <SolidColorBrush x:Key="HistoryMissedBrush" Color="{StaticResource PhoneHangupRed}" />
    <SolidColorBrush x:Key="HistoryAnsweredBrush" Color="{StaticResource PhoneCallGreen}" />
    <SolidColorBrush x:Key="HistoryCancelBrush" Color="{StaticResource PhoneAccent}" />
    <SolidColorBrush x:Key="HistoryOutboundBrush" Color="{StaticResource PhoneAccent}" />
    <SolidColorBrush x:Key="HistoryInboundBrush" Color="{StaticResource PhoneCallGreen}" />
    <SolidColorBrush x:Key="HistoryMissedBgBrush" Color="{StaticResource HistoryMissedTint}" />
    <SolidColorBrush x:Key="HistoryAnsweredBgBrush" Color="{StaticResource HistoryAnsweredTint}" />
    <SolidColorBrush x:Key="HistoryCancelBgBrush" Color="{StaticResource HistoryCancelTint}" />
    <SolidColorBrush x:Key="HistoryOutboundBgBrush" Color="{StaticResource HistoryOutboundTint}" />
    <SolidColorBrush x:Key="HistoryInboundBgBrush" Color="{StaticResource HistoryInboundTint}" />

    <!-- Compact 300×600 typography: Title 15 > Body 12 > Secondary 11 > Caption 10 > Meta 10 -->
    <FontFamily x:Key="PhoneUiFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="PhoneDisplayFont">Segoe UI Variable Display, Segoe UI Semibold, sans-serif</FontFamily>
    <FontFamily x:Key="PhoneMonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <Style x:Key="TypeTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PhoneDisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextPrimaryBrush}" />
    </Style>

    <Style x:Key="TypeBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PhoneUiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextPrimaryBrush}" />
    </Style>

    <Style x:Key="TypeSecondary" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PhoneUiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextSecondaryBrush}" />
    </Style>

    <Style x:Key="TypeCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PhoneUiFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextSecondaryBrush}" />
    </Style>

    <Style x:Key="TypeMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PhoneUiFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextTertiaryBrush}" />
    </Style>

    <Style x:Key="TypeHeroCaller" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PhoneDisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextPrimaryBrush}" />
    </Style>

    <Style x:Key="TypeHeroNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontFamily" Value="{StaticResource PhoneMonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextSecondaryBrush}" />
    </Style>

    <Style x:Key="MonospaceDialText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PhoneMonoFont}" />
    </Style>

    <Style x:Key="ListItemPrimaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextPrimaryBrush}" />
    </Style>

    <Style x:Key="ListItemSecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextSecondaryBrush}" />
    </Style>

    <Style x:Key="ListItemMetaText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource PhoneTextTertiaryBrush}" />
    </Style>

    <!-- Legacy 24x24 icons (no Material viewBox — settings gear, envelope message, minimize line) -->
